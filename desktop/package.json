{
  "name": "couchcast-desktop",
  "productName": "Couchcast",
  "version": "0.2.0",
  "private": true,
  "description": "PS5 → navigateur : flux, clips, enregistrement et live",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "icons": "./make-icons.sh",
    "dist": "./package.sh"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.couchcast.desktop",
    "productName": "Couchcast",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/web",
        "to": "web"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Couchcast communique avec votre PS5 sur le réseau local."
      }
    },
    "artifactName": "Couchcast-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "dmg": {
      "title": "Couchcast"
    }
  },
  "license": "AGPL-3.0-only"
}
